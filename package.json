{
  "name": "myprojectusa-web",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "cf-typegen": "wrangler types --strict-vars=false",
    "db:migrate:local": "wrangler d1 migrations apply myprojectusa --local",
    "db:migrate:remote": "wrangler d1 migrations apply myprojectusa --remote",
    "admin:create": "tsx scripts/create-admin.ts",
    "audit:crawl": "tsx scripts/audit/crawl.ts",
    "import:transform": "tsx scripts/import/transform.ts",
    "import:push": "tsx scripts/import/push.ts",
    "docs:inventory": "tsx scripts/audit/inventory.ts",
    "test": "npm run test:worker && npm run test:content && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:worker": "vitest run -c tests/worker/vitest.config.ts",
    "test:content": "vitest run -c tests/content/vitest.config.ts",
    "check": "tsc -b && npm run lint && npm run test:unit",
    "test:unit": "npm run test:worker && npm run test:content"
  },
  "type": "module",
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dom-serializer": "^3.1.1",
    "domhandler": "^6.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "htmlparser2": "^12.0.0",
    "image-size": "^2.0.4",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261012.1": true,
    "workerd@1.20261019.1": true
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "gsap": "^3.15.0",
    "hono": "^4.13.13",
    "lucide-react": "^1.61.0",
    "motion": "^14.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  }
}