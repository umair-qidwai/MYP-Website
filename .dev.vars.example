# Copy to .dev.vars for local development. Never commit .dev.vars.
ENVIRONMENT=development
PUBLIC_SITE_URL=http://localhost:5180
# Cloudflare's documented Turnstile test secret: always passes. Use a real secret in production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Random string (32+ chars) mixed into password hashes. Generate with: openssl rand -base64 32
PASSWORD_PEPPER=dev-only-pepper-change-me-0123456789abcdef
# Enables the bulk content import API (scripts/import). Remove in production when not importing.
IMPORT_TOKEN=dev-import-token-0123456789abcdef0123456789
